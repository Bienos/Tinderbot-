# Generate: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# If blank, generated in runtime/dashboard-token (0600).
DASHBOARD_TOKEN=
# Local default below. On Render omit PUBLIC_ORIGIN to use its generated HTTPS URL.
# For a custom domain set its exact HTTPS origin.
PUBLIC_ORIGIN=http://127.0.0.1:8765
COOKIE_SECURE=false
AGENT_DB_PATH=runtime/agent.db
WORKER_ENABLED=true
WORKER_INTERVAL=5
DATING_AGENT_SOURCE=browser
SEED_SIMULATOR=true
# Set in the dashboard: supervised (default), simulation, authorized_autonomy.
# Live autonomous replies require explicit per-thread grants and Telegram rights.
# Explicit selection prevents implicit fallback to another provider.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# To use Claude: LLM_PROVIDER=anthropic and set ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
SEMANTIC_OUTCOMES=false
# Optional pricing, update from the provider's current price list. Zero means unpriced.
LLM_INPUT_USD_PER_MILLION=0
LLM_OUTPUT_USD_PER_MILLION=0
# Optional path overrides; leave unset to use Playwright defaults / run.sh local browser path.
# PLAYWRIGHT_BROWSERS_PATH=
# CHROMIUM_EXECUTABLE=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFY_TO=
NOTIFY_FROM=
# Optional unofficial OpenDate-derived Tinder connection.
# Configure credentials locally, restart, then Settings > Connect Tinder.
# Connecting enables automatic replies in consented/disclosed threads.
TINDER_ENABLED=false
TINDER_AUTH_TOKEN=
# Optional read-only profile diagnostic on restart; never enables a connection.
TINDER_STARTUP_CHECK=false
# Optional identity pin; profile is always verified against the connected account.
TINDER_OWNER_ID=
# Polling only (no supported webhook); minimum 60 seconds. These are not platform-approved safe rates.
TINDER_POLL_INTERVAL=180
TINDER_IDLE_POLL_INTERVAL=900
TINDER_INACTIVE_THREAD_REFRESH=3600
TINDER_REQUESTS_PER_MINUTE=30
TINDER_REQUESTS_PER_HOUR=300
TINDER_SENDS_PER_THREAD_HOUR=10
TINDER_SENDS_PER_HOUR=20
TINDER_SENDS_PER_DAY=100
# Campaigns (the agent writes first messages to selected new matches). Application choices, not platform-approved rates.
# Profiles (Ostrożny / Zrównoważony / Szybki) set spacing, daily cap and window per run. Setting one of these overrides all profiles.
# CAMPAIGN_GAP_SECONDS=300
# CAMPAIGN_OPENERS_PER_DAY=15
# CAMPAIGN_WINDOW=17:00-22:30   # local time, or "always"
CAMPAIGN_REPLY_RESERVE=5
AUTOMATION_TZ=Europe/Warsaw
# Security budgets; these never change conversation initiative or require per-message approval.
MODEL_CALLS_PER_MINUTE=30
AUTO_SENDS_PER_THREAD_HOUR=60
AUTO_SENDS_TOTAL_PER_HOUR=200
# Optional: Tinder web client identification (defaults match the current web app; bump if Tinder returns 401 again)
# TINDER_APP_VERSION=1074202
# TINDER_VERSION=7.42.2
# TINDER_LOCALE=en-GB
# TINDER_DEVICE_ID=
